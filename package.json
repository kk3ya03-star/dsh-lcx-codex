{
  "name": "dsh-lcx-codex",
  "version": "0.4.3-pre.3",
  "description": "Model-scoped DSH plugin: GPT Responses lifecycle, Native V2 compaction and Hosted/Alpha Search; Grok native Web/X Search",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "web-search",
    "openai-responses",
    "sub2api",
    "newapi",
    "compaction",
    "grok",
    "xai",
    "x-search"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kk3ya03-star/dsh-lcx-codex.git"
  },
  "homepage": "https://github.com/kk3ya03-star/dsh-lcx-codex#readme",
  "bugs": {
    "url": "https://github.com/kk3ya03-star/dsh-lcx-codex/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.28.2",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-modules": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-compaction": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-fs": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-settings": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-tool-web": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-web": "0.1.3-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-modules": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-store": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings-plugins": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-web": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-web": {
      "optional": true
    }
  },
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "probe:alpha": "node scripts/probe-alpha.mjs",
    "pack:local": "npm pack --ignore-scripts",
    "test:schema": "node scripts/validate-dsh-schema.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
