{
  "name": "dsh-lcx-codex",
  "version": "0.5.0-pre.1",
  "description": "Model-scoped DSH plugin: GPT Responses lifecycle, Native V2 compaction and Hosted/Alpha Search; Grok native Web/X Search",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "web-search",
    "openai-responses",
    "sub2api",
    "newapi",
    "compaction",
    "grok",
    "xai",
    "x-search"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kk3ya03-star/dsh-lcx-codex.git"
  },
  "homepage": "https://github.com/kk3ya03-star/dsh-lcx-codex#readme",
  "bugs": {
    "url": "https://github.com/kk3ya03-star/dsh-lcx-codex/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/types/index.d.ts",
    "lib/types/client/index.d.ts",
    "lib/types/client/search-media.d.ts",
    "cordis.patch.yml",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@earendil-works/pi-ai": "0.87.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.13",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.5",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-attachment": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-client-modules": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-client-store": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-compaction": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-fs": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-session-query": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-tool-web": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-web": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-token-meter": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-session-projection": ">=0.2.0-rc.2 <0.2.1",
    "zod": "^4.5.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis-plugin-loader": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-modules": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-store": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-chat": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-plugin-manager": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-query": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-web": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-web": {
      "optional": true
    }
  },
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "build:host": "tsc -p tsconfig.json && node scripts/build-pi-runtime.mjs",
    "build:client": "tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "probe:alpha": "node scripts/probe-alpha.mjs",
    "pack:local": "npm pack --ignore-scripts",
    "test:schema": "node scripts/validate-dsh-schema.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "lcxCompatibility": {
    "dshInstallRange": ">=0.2.0-rc.2 <0.2.1",
    "verifiedDsh": "0.2.0-rc.2",
    "verifiedHostPi": "0.87.1",
    "verifiedPluginPi": "0.87.1"
  }
}
